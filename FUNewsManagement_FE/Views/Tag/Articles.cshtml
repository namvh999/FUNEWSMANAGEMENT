@model FUNewsManagement_FE.Controllers.TagArticlesResponse
@{
    ViewData["Title"] = $"Bài viết gắn thẻ #{Model.Tag.TagName}";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh mục Thẻ
    </a>
    <h2 class="fw-bold mb-1">
        <i class="bi bi-tag-fill text-primary me-2"></i>Thẻ: <span class="text-primary">#@Model.Tag.TagName</span>
    </h2>
    <p class="text-muted small">
        @(string.IsNullOrEmpty(Model.Tag.Note) ? "Không có ghi chú" : Model.Tag.Note) • Tổng cộng: <strong>@Model.Articles.Count</strong> bài viết
    </p>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>Tiêu đề bài viết</th>
                    <th>Chuyên mục</th>
                    <th>Tác giả</th>
                    <th>Ngày tạo</th>
                    <th class="text-center">Lượt xem</th>
                    <th class="text-end">Chi tiết</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Articles != null && Model.Articles.Any())
                {
                    foreach (var a in Model.Articles)
                    {
                        <tr>
                            <td class="fw-bold text-muted">@a.NewsArticleID</td>
                            <td>
                                <a asp-controller="News" asp-action="Detail" asp-route-id="@a.NewsArticleID" class="fw-bold text-decoration-none text-dark hover-primary">
                                    @a.NewsTitle
                                </a>
                                @if (!string.IsNullOrEmpty(a.Headline))
                                {
                                    <small class="text-muted d-block text-truncate" style="max-width: 450px;">@a.Headline</small>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@a.CategoryName</span></td>
                            <td class="small">@a.CreatedByName</td>
                            <td class="small text-muted">@a.CreatedDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-center"><span class="badge bg-info-subtle text-info">@a.ViewCount</span></td>
                            <td class="text-end">
                                <a asp-controller="News" asp-action="Detail" asp-route-id="@a.NewsArticleID" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i>Đọc bài
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="bi bi-journal-x fs-1 d-block mb-2"></i>Chưa có bài viết nào được gắn thẻ này.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
