@model FUNewsManagement_FE.Models.PagedAuditLogResult
@{
    ViewData["Title"] = "Nhật ký Kiểm toán (Audit Log)";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-clock-history text-primary me-2"></i>Nhật ký Kiểm toán (Audit Log)</h2>
        <p class="text-muted small mb-0">Theo dõi toàn bộ lịch sử thao tác CRUD của người dùng trong hệ thống</p>
    </div>
</div>

<!-- Filters -->
<div class="card mb-3 bg-white">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="user" value="@ViewBag.User" class="form-control form-control-sm" placeholder="Tìm theo Người dùng (Email/Tên)..." />
            </div>
            <div class="col-md-3">
                <select name="entity" class="form-select form-select-sm">
                    <option value="">-- Tất cả Đối tượng (Entity) --</option>
                    <option value="NewsArticle" selected="@(ViewBag.Entity == "NewsArticle")">Bài viết (NewsArticle)</option>
                    <option value="Category" selected="@(ViewBag.Entity == "Category")">Chuyên mục (Category)</option>
                    <option value="Tag" selected="@(ViewBag.Entity == "Tag")">Thẻ (Tag)</option>
                    <option value="SystemAccount" selected="@(ViewBag.Entity == "SystemAccount")">Tài khoản (Account)</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="action" class="form-select form-select-sm">
                    <option value="">-- Tất cả Hành động (Action) --</option>
                    <option value="CREATE" selected="@(ViewBag.Action == "CREATE")">Thêm mới (CREATE)</option>
                    <option value="UPDATE" selected="@(ViewBag.Action == "UPDATE")">Cập nhật (UPDATE)</option>
                    <option value="DELETE" selected="@(ViewBag.Action == "DELETE")">Xóa (DELETE)</option>
                    <option value="LOGIN" selected="@(ViewBag.Action == "LOGIN")">Đăng nhập (LOGIN)</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-filter"></i> Lọc dữ liệu
                </button>
            </div>
            <div class="col-md-1">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">Xóa</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 60px;">#</th>
                    <th>Thời gian</th>
                    <th>Người thực hiện</th>
                    <th class="text-center">Hành động</th>
                    <th>Đối tượng (Entity)</th>
                    <th>Mã đối tượng</th>
                    <th class="text-center" style="width: 140px;">Dữ liệu JSON</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Data != null && Model.Data.Any())
                {
                    foreach (var log in Model.Data)
                    {
                        <tr>
                            <td class="text-muted fw-bold">@log.AuditID</td>
                            <td class="small text-muted">@log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>
                                <strong>@log.UserName</strong>
                                <span class="text-muted small d-block">ID: @log.UserId</span>
                            </td>
                            <td class="text-center">
                                @if (log.Action == "CREATE")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">CREATE</span>
                                }
                                else if (log.Action == "UPDATE" || log.Action == "UPDATE_PASSWORD")
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">UPDATE</span>
                                }
                                else if (log.Action == "DELETE")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">DELETE</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">@log.Action</span>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@log.Entity</span></td>
                            <td><code>@(log.EntityId ?? "—")</code></td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-dark"
                                        onclick="showJsonDiffModal(@log.AuditID, '@log.Action', '@log.Entity', '@Html.Raw(JavaScriptEscape(log.BeforeData ?? ""))', '@Html.Raw(JavaScriptEscape(log.AfterData ?? ""))')">
                                    <i class="bi bi-code-slash me-1"></i>Xem JSON
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="bi bi-clock-history fs-1 d-block mb-2"></i>Chưa có bản ghi nhật ký kiểm toán nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Trang @Model.Page / @Model.TotalPages (Tổng @Model.TotalItems bản ghi)</span>
            <ul class="pagination pagination-sm mb-0">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-user="@ViewBag.User" asp-route-entity="@ViewBag.Entity" asp-route-action="@ViewBag.Action">@p</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>

<!-- Modal JSON Diff Viewer (Section 4.12: Display Before/After data in JSON format) -->
<div class="modal fade" id="jsonDiffModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="bi bi-braces me-2"></i>Chi tiết Dữ liệu JSON (<span id="diffModalTitle"></span>)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-danger"><i class="bi bi-arrow-left-circle me-1"></i>Dữ liệu Trước (Before Data):</label>
                        <pre id="beforeJsonBox" class="bg-light p-3 border rounded small text-danger" style="max-height: 300px; overflow-y: auto; white-space: pre-wrap; font-family: monospace;"></pre>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-success"><i class="bi bi-arrow-right-circle me-1"></i>Dữ liệu Sau (After Data):</label>
                        <pre id="afterJsonBox" class="bg-light p-3 border rounded small text-success" style="max-height: 300px; overflow-y: auto; white-space: pre-wrap; font-family: monospace;"></pre>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@functions {
    public string JavaScriptEscape(string input) =>
        string.IsNullOrEmpty(input) ? "" : input.Replace("\\", "\\\\").Replace("'", "\\'").Replace("\"", "\\\"").Replace("\r", "").Replace("\n", "\\n");
}

@section Scripts {
<script>
    function showJsonDiffModal(id, action, entity, beforeJson, afterJson) {
        document.getElementById('diffModalTitle').innerText = `${action} ${entity} #${id}`;

        const format = (raw) => {
            if (!raw || raw.trim() === '') return '(Không có dữ liệu)';
            try {
                return JSON.stringify(JSON.parse(raw), null, 2);
            } catch {
                return raw;
            }
        };

        document.getElementById('beforeJsonBox').innerText = format(beforeJson);
        document.getElementById('afterJsonBox').innerText = format(afterJson);

        new bootstrap.Modal(document.getElementById('jsonDiffModal')).show();
    }
</script>
}
