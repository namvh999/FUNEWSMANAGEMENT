@model FUNewsManagement_FE.Models.DashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển & Thống kê";
    var categories = ViewBag.Categories as List<FUNewsManagement_FE.Models.CategoryViewModel> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>Thống kê tổng quan (Dashboard)</h2>
        <p class="text-muted small mb-0">Dữ liệu phân tích thời gian thực từ Analytics API</p>
    </div>
    <div>
        <a asp-action="Export"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate"
           asp-route-categoryId="@ViewBag.SelectedCategoryId"
           class="btn btn-success shadow-sm">
            <i class="bi bi-file-earmark-excel me-1"></i>Xuất Báo Cáo Excel
        </a>
    </div>
</div>

<!-- Filters Card -->
<div class="card mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Từ ngày:</label>
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Đến ngày:</label>
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Chuyên mục:</label>
                <select name="categoryId" class="form-select form-select-sm">
                    <option value="">-- Tất cả chuyên mục --</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.CategoryID" selected="@(ViewBag.SelectedCategoryId == c.CategoryID)">@c.CategoryName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Trạng thái:</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">-- Tất cả --</option>
                    <option value="true" selected="@(ViewBag.SelectedStatus == true)">Đang hoạt động</option>
                    <option value="false" selected="@(ViewBag.SelectedStatus == false)">Ngừng hoạt động</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-filter"></i> Lọc
                </button>
            </div>
        </form>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-uppercase small fw-bold text-white-50">Tổng bài viết</div>
                    <div class="fs-2 fw-bold">@Model.TotalArticles</div>
                </div>
                <i class="bi bi-newspaper fs-1 text-white-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-uppercase small fw-bold text-white-50">Đang hoạt động</div>
                    <div class="fs-2 fw-bold">@Model.ActiveArticles</div>
                </div>
                <i class="bi bi-check2-circle fs-1 text-white-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-dark p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-uppercase small fw-bold text-black-50">Ngừng hoạt động</div>
                    <div class="fs-2 fw-bold">@Model.InactiveArticles</div>
                </div>
                <i class="bi bi-pause-circle fs-1 text-black-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-uppercase small fw-bold text-white-50">Tổng lượt xem</div>
                    <div class="fs-2 fw-bold">@Model.TotalViews.ToString("N0")</div>
                </div>
                <i class="bi bi-eye fs-1 text-white-50"></i>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <!-- Pie Chart: By Category -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header bg-white py-3">
                <h5 class="card-title fw-bold mb-0"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Phân bố theo Chuyên mục</h5>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center" style="min-height: 320px;">
                <canvas id="categoryPieChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Bar Chart: Top Authors -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header bg-white py-3">
                <h5 class="card-title fw-bold mb-0"><i class="bi bi-bar-chart-fill text-success me-2"></i>Thống kê Bài viết & Lượt xem theo Tác giả</h5>
            </div>
            <div class="card-body" style="min-height: 320px;">
                <canvas id="authorBarChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // 1. Category Pie Chart
    const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ArticlesByCategory.Select(c => c.CategoryName)));
    const catData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ArticlesByCategory.Select(c => c.ArticleCount)));

    new Chart(document.getElementById('categoryPieChart'), {
        type: 'pie',
        data: {
            labels: catLabels.length > 0 ? catLabels : ['Chưa có dữ liệu'],
            datasets: [{
                data: catData.length > 0 ? catData : [1],
                backgroundColor: ['#0d6efd', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#06b6d4', '#64748b']
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });

    // 2. Author Bar Chart
    const authorLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ArticlesByAuthor.Select(a => a.AuthorName)));
    const authorArticles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ArticlesByAuthor.Select(a => a.ArticleCount)));
    const authorViews = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ArticlesByAuthor.Select(a => a.TotalViews)));

    new Chart(document.getElementById('authorBarChart'), {
        type: 'bar',
        data: {
            labels: authorLabels,
            datasets: [
                {
                    label: 'Số bài viết',
                    data: authorArticles,
                    backgroundColor: '#0d6efd'
                },
                {
                    label: 'Tổng lượt xem',
                    data: authorViews,
                    backgroundColor: '#10b981'
                }
            ]
        },
        options: {
            responsive: true,
            scales: {
                y: { beginAtZero: true }
            }
        }
    });
</script>
}
