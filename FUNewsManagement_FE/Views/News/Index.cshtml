@model FUNewsManagement_FE.Models.PagedNewsResult
@{
    ViewData["Title"] = "Quản lý Bài viết";
    var categories = ViewBag.Categories as List<FUNewsManagement_FE.Models.CategoryViewModel> ?? new();
    var allTags = ViewBag.AllTags as List<FUNewsManagement_FE.Models.TagViewModel> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-newspaper text-primary me-2"></i>Quản lý Tin tức (News)</h2>
        <p class="text-muted small mb-0">Danh sách bài viết, phân trang và tìm kiếm</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#createNewsModal">
            <i class="bi bi-plus-circle me-1"></i>Thêm bài viết mới
        </button>
    </div>
</div>

<!-- Filters & Search Bar -->
<div class="card mb-3 bg-white">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tiêu đề, tóm tắt hoặc nội dung..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="categoryId" class="form-select form-select-sm">
                    <option value="">-- Tất cả chuyên mục --</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.CategoryID" selected="@(ViewBag.CategoryId == c.CategoryID)">@c.CategoryName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="true" selected="@(ViewBag.Status == true)">Đang kích hoạt (Active)</option>
                    <option value="false" selected="@(ViewBag.Status == false)">Ngừng kích hoạt (Inactive)</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="sortBy" class="form-select form-select-sm">
                    <option value="date_desc" selected="@(ViewBag.SortBy == "date_desc")">Mới nhất trước</option>
                    <option value="date_asc" selected="@(ViewBag.SortBy == "date_asc")">Cũ nhất trước</option>
                    <option value="views_desc" selected="@(ViewBag.SortBy == "views_desc")">Nhiều lượt xem nhất</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-secondary btn-sm w-100">Tìm</button>
            </div>
        </form>
    </div>
</div>

<!-- News Table -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>Tiêu đề bài viết</th>
                    <th>Chuyên mục</th>
                    <th>Thẻ (Tags)</th>
                    <th>Tác giả</th>
                    <th>Ngày tạo</th>
                    <th class="text-center">Lượt xem</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end" style="width: 150px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Data != null && Model.Data.Any())
                {
                    foreach (var item in Model.Data)
                    {
                        <tr>
                            <td class="fw-bold text-muted">@item.NewsArticleID</td>
                            <td>
                                <a asp-action="Detail" asp-route-id="@item.NewsArticleID" class="fw-bold text-decoration-none text-dark hover-primary d-block">
                                    @item.NewsTitle
                                </a>
                                @if (!string.IsNullOrEmpty(item.Headline))
                                {
                                    <small class="text-muted d-block text-truncate" style="max-width: 380px;">@item.Headline</small>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@item.CategoryName</span></td>
                            <td>
                                @if (item.Tags != null && item.Tags.Any())
                                {
                                    foreach (var t in item.Tags)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border me-1">#@t.TagName</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Không có</span>
                                }
                            </td>
                            <td class="small">@item.CreatedByName</td>
                            <td class="small text-muted">@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center"><span class="badge bg-info-subtle text-info fw-semibold">@item.ViewCount</span></td>
                            <td class="text-center">
                                @if (item.NewsStatus)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle me-1"></i>Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-x-circle me-1"></i>Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Detail" asp-route-id="@item.NewsArticleID" class="btn btn-sm btn-outline-info me-1" title="Xem chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-primary me-1" title="Chỉnh sửa"
                                        onclick="openEditNewsModal(@item.NewsArticleID, '@Html.Raw(JavaScriptEscape(item.NewsTitle))', '@Html.Raw(JavaScriptEscape(item.Headline ?? ""))', '@Html.Raw(JavaScriptEscape(item.NewsContent))', '@Html.Raw(JavaScriptEscape(item.NewsSource ?? ""))', @item.CategoryID, @(item.NewsStatus ? "true" : "false"), '@(item.FeaturedImage ?? "")', [@string.Join(",", item.Tags?.Select(t => t.TagID) ?? new int[0])])">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="Xóa"
                                        onclick="confirmDeleteNews(@item.NewsArticleID, '@Html.Raw(JavaScriptEscape(item.NewsTitle))')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>Không tìm thấy bài viết nào phù hợp.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Hiển thị trang @Model.Page / @Model.TotalPages (Tổng @Model.TotalItems bài viết)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@ViewBag.Search" asp-route-categoryId="@ViewBag.CategoryId" asp-route-status="@ViewBag.Status">&laquo;</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@ViewBag.Search" asp-route-categoryId="@ViewBag.CategoryId" asp-route-status="@ViewBag.Status">@p</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@ViewBag.Search" asp-route-categoryId="@ViewBag.CategoryId" asp-route-status="@ViewBag.Status">&raquo;</a>
                </li>
            </ul>
        </div>
    }
</div>

<!-- ========================================== -->
<!-- CREATE NEWS MODAL (With AI Tag Suggestion) -->
<!-- ========================================== -->
<div class="modal fade" id="createNewsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-action="Create" method="post" id="createNewsForm">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-file-earmark-plus me-2"></i>Thêm bài viết mới</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tiêu đề bài viết <span class="text-danger">*</span></label>
                        <input type="text" name="newsTitle" class="form-control" placeholder="Nhập tiêu đề..." required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Chuyên mục <span class="text-danger">*</span></label>
                            <select name="categoryId" class="form-select" required>
                                <option value="">-- Chọn chuyên mục --</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.CategoryID">@c.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Nguồn tin</label>
                            <input type="text" name="newsSource" class="form-control" placeholder="Ví dụ: VnExpress, Microsoft Blog..." />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tóm tắt ngắn (Headline)</label>
                        <input type="text" name="headline" class="form-control" placeholder="Mô tả tóm tắt nội dung chính..." />
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold mb-0">Nội dung bài viết <span class="text-danger">*</span></label>
                            <!-- AI Tag Suggestion Button (Section 4.9) -->
                            <button type="button" class="btn btn-outline-warning btn-sm text-dark fw-bold" onclick="suggestAiTags('create')">
                                <i class="bi bi-stars text-warning me-1"></i>💡 Gợi ý Tags (AI API)
                            </button>
                        </div>
                        <textarea name="newsContent" id="createNewsContent" class="form-control" rows="6" placeholder="Nhập nội dung chi tiết bài viết..." required></textarea>
                    </div>

                    <!-- AI Tag Suggestions Container -->
                    <div id="createAiSuggestionsBox" class="p-3 bg-light border rounded mb-3" style="display:none;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-primary"><i class="bi bi-robot me-1"></i>Thẻ Tag được AI gợi ý (Nhấp để chọn nhanh):</span>
                            <span class="badge bg-secondary" id="createAiSourceBadge">AI & Learning Cache</span>
                        </div>
                        <div id="createAiTagsContainer" class="d-flex flex-wrap gap-2"></div>
                    </div>

                    <!-- Tags Checkboxes -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold d-block">Gắn thẻ Tags</label>
                        <div class="d-flex flex-wrap gap-2 p-2 border rounded bg-light" id="createTagsList">
                            @foreach (var t in allTags)
                            {
                                <div class="form-check form-check-inline me-2">
                                    <input class="form-check-input" type="checkbox" name="tagIds" value="@t.TagID" id="create_tag_@t.TagID" data-tagname="@t.TagName">
                                    <label class="form-check-label small" for="create_tag_@t.TagID">#@t.TagName</label>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Image Upload -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ảnh đại diện bài viết</label>
                        <input type="file" id="createImageFile" class="form-control form-control-sm mb-2" accept=".jpg,.jpeg,.png,.webp,.gif" onchange="uploadArticleImage('create')" />
                        <input type="hidden" name="featuredImage" id="createFeaturedImage" />
                        <div id="createImagePreviewBox" class="border rounded p-2 text-center" style="display:none; max-width: 250px;">
                            <img id="createImagePreview" src="" class="img-fluid rounded" style="max-height: 140px;" />
                        </div>
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="newsStatus" value="true" id="createStatus" checked>
                        <label class="form-check-label fw-semibold" for="createStatus">Kích hoạt bài viết (Active)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Lưu bài viết</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- EDIT NEWS MODAL -->
<!-- ========================================== -->
<div class="modal fade" id="editNewsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form id="editNewsForm" method="post">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa bài viết</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tiêu đề bài viết <span class="text-danger">*</span></label>
                        <input type="text" name="newsTitle" id="editNewsTitle" class="form-control" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Chuyên mục <span class="text-danger">*</span></label>
                            <select name="categoryId" id="editCategoryId" class="form-select" required>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.CategoryID">@c.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Nguồn tin</label>
                            <input type="text" name="newsSource" id="editNewsSource" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tóm tắt ngắn (Headline)</label>
                        <input type="text" name="headline" id="editHeadline" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold mb-0">Nội dung bài viết <span class="text-danger">*</span></label>
                            <button type="button" class="btn btn-outline-warning btn-sm text-dark fw-bold" onclick="suggestAiTags('edit')">
                                <i class="bi bi-stars text-warning me-1"></i>💡 Gợi ý Tags (AI)
                            </button>
                        </div>
                        <textarea name="newsContent" id="editNewsContent" class="form-control" rows="6" required></textarea>
                    </div>

                    <div id="editAiSuggestionsBox" class="p-3 bg-light border rounded mb-3" style="display:none;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-primary"><i class="bi bi-robot me-1"></i>Thẻ Tag được AI gợi ý:</span>
                        </div>
                        <div id="editAiTagsContainer" class="d-flex flex-wrap gap-2"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold d-block">Gắn thẻ Tags</label>
                        <div class="d-flex flex-wrap gap-2 p-2 border rounded bg-light" id="editTagsList">
                            @foreach (var t in allTags)
                            {
                                <div class="form-check form-check-inline me-2">
                                    <input class="form-check-input edit-tag-check" type="checkbox" name="tagIds" value="@t.TagID" id="edit_tag_@t.TagID" data-tagname="@t.TagName">
                                    <label class="form-check-label small" for="edit_tag_@t.TagID">#@t.TagName</label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ảnh đại diện bài viết</label>
                        <input type="file" id="editImageFile" class="form-control form-control-sm mb-2" accept=".jpg,.jpeg,.png,.webp,.gif" onchange="uploadArticleImage('edit')" />
                        <input type="hidden" name="featuredImage" id="editFeaturedImage" />
                        <div id="editImagePreviewBox" class="border rounded p-2 text-center" style="display:none; max-width: 250px;">
                            <img id="editImagePreview" src="" class="img-fluid rounded" style="max-height: 140px;" />
                        </div>
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="newsStatus" value="true" id="editStatus">
                        <label class="form-check-label fw-semibold" for="editStatus">Kích hoạt bài viết (Active)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Hidden Delete Form -->
<form id="deleteNewsForm" method="post" style="display:none;"></form>

@functions {
    public string JavaScriptEscape(string input)
    {
        if (string.IsNullOrEmpty(input)) return "";
        return input.Replace("\\", "\\\\").Replace("'", "\\'").Replace("\"", "\\\"").Replace("\r", "").Replace("\n", "\\n");
    }
}

@section Scripts {
<script>
    // Open Edit Modal with Pre-filled values
    function openEditNewsModal(id, title, headline, content, source, categoryId, status, image, tagIds) {
        document.getElementById('editNewsForm').action = '/News/Edit/' + id;
        document.getElementById('editNewsTitle').value = title;
        document.getElementById('editHeadline').value = headline;
        document.getElementById('editNewsContent').value = content;
        document.getElementById('editNewsSource').value = source;
        document.getElementById('editCategoryId').value = categoryId;
        document.getElementById('editStatus').checked = status;
        document.getElementById('editFeaturedImage').value = image;

        if (image) {
            document.getElementById('editImagePreview').src = image;
            document.getElementById('editImagePreviewBox').style.display = 'block';
        } else {
            document.getElementById('editImagePreviewBox').style.display = 'none';
        }

        // Check assigned tags
        document.querySelectorAll('.edit-tag-check').forEach(cb => {
            cb.checked = tagIds.includes(parseInt(cb.value));
        });

        new bootstrap.Modal(document.getElementById('editNewsModal')).show();
    }

    // Confirm Delete
    function confirmDeleteNews(id, title) {
        confirmAction(`Bạn có chắc chắn muốn xóa bài viết "${title}" (Mã #${id})?`, function() {
            const form = document.getElementById('deleteNewsForm');
            form.action = '/News/Delete/' + id;
            form.submit();
        });
    }

    // AI Tag Suggestion Call (Section 4.9)
    async function suggestAiTags(mode) {
        const textareaId = mode === 'create' ? 'createNewsContent' : 'editNewsContent';
        const boxId = mode === 'create' ? 'createAiSuggestionsBox' : 'editAiSuggestionsBox';
        const containerId = mode === 'create' ? 'createAiTagsContainer' : 'editAiTagsContainer';
        const content = document.getElementById(textareaId).value;

        if (!content || content.trim().length < 10) {
            alert('Vui lòng nhập nội dung bài viết ít nhất 10 ký tự để AI có thể phân tích từ khóa.');
            return;
        }

        showLoading();
        try {
            const res = await fetch('/News/SuggestTags', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content: content })
            });

            if (res.ok) {
                const tags = await res.json();
                const container = document.getElementById(containerId);
                container.innerHTML = '';

                if (tags && tags.length > 0) {
                    tags.forEach(t => {
                        const chip = document.createElement('button');
                        chip.type = 'button';
                        chip.className = 'btn btn-sm btn-outline-primary rounded-pill';
                        chip.innerHTML = `<i class="bi bi-tag-fill me-1"></i><strong>${t.tagName}</strong> <span class="badge bg-primary text-white ms-1">${Math.round(t.confidence * 100)}%</span>`;
                        chip.title = `Nguồn: ${t.source}. Nhấp để chọn thẻ này.`;
                        chip.onclick = function() {
                            selectTagByName(mode, t.tagName);
                            chip.className = 'btn btn-sm btn-primary rounded-pill';
                        };
                        container.appendChild(chip);
                    });
                    document.getElementById(boxId).style.display = 'block';
                } else {
                    alert('Không tìm thấy gợi ý phù hợp.');
                }
            } else {
                alert('Không thể kết nối đến AI API lúc này.');
            }
        } catch (e) {
            alert('Lỗi gọi AI API: ' + e);
        } finally {
            hideLoading();
        }
    }

    // Helper: Select checkbox if tag exists in system
    function selectTagByName(mode, tagName) {
        const prefix = mode === 'create' ? 'create_tag_' : 'edit_tag_';
        let found = false;
        document.querySelectorAll(`[id^="${prefix}"]`).forEach(cb => {
            if (cb.dataset.tagname && cb.dataset.tagname.toLowerCase() === tagName.toLowerCase()) {
                cb.checked = true;
                found = true;
            }
        });
        if (!found) {
            alert(`Thẻ "${tagName}" được gợi ý nhưng chưa tồn tại trong danh mục Thẻ của hệ thống. Bạn có thể tạo thẻ mới này tại trang Quản lý Thẻ (Tags).`);
        }
    }

    // Upload Article Image
    async function uploadArticleImage(mode) {
        const fileInput = document.getElementById(mode === 'create' ? 'createImageFile' : 'editImageFile');
        const hiddenInput = document.getElementById(mode === 'create' ? 'createFeaturedImage' : 'editFeaturedImage');
        const previewBox = document.getElementById(mode === 'create' ? 'createImagePreviewBox' : 'editImagePreviewBox');
        const previewImg = document.getElementById(mode === 'create' ? 'createImagePreview' : 'editImagePreview');

        if (!fileInput.files || fileInput.files.length === 0) return;

        const formData = new FormData();
        formData.append('file', fileInput.files[0]);

        showLoading();
        try {
            const res = await fetch('/News/UploadImage', {
                method: 'POST',
                body: formData
            });

            const data = await res.json();
            if (res.ok && data.success) {
                hiddenInput.value = data.url;
                previewImg.src = data.url;
                previewBox.style.display = 'block';
            } else {
                alert(data.message || 'Tải ảnh lên thất bại.');
            }
        } catch (e) {
            alert('Lỗi tải ảnh lên: ' + e);
        } finally {
            hideLoading();
        }
    }
</script>
}
