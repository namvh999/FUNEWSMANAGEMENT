@model List<FUNewsManagement_FE.Models.AccountViewModel>
@{
    ViewData["Title"] = "Quản lý Tài khoản";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-people text-primary me-2"></i>Quản lý Tài khoản (Admin)</h2>
        <p class="text-muted small mb-0">Quản lý người dùng, phân quyền Admin/Staff và bảo mật mật khẩu</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#createAccountModal">
            <i class="bi bi-person-plus me-1"></i>Thêm tài khoản mới
        </button>
    </div>
</div>

<!-- Filter by Role -->
<div class="card mb-3 bg-white">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select name="role" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Tất cả vai trò --</option>
                    <option value="1" selected="@(ViewBag.SelectedRole == 1)">Quản trị viên (Admin)</option>
                    <option value="2" selected="@(ViewBag.SelectedRole == 2)">Nhân viên biên tập (Staff)</option>
                </select>
            </div>
            @if (ViewBag.SelectedRole != null)
            {
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa lọc</a>
                </div>
            }
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 60px;">#</th>
                    <th>Họ và tên</th>
                    <th>Địa chỉ Email</th>
                    <th class="text-center">Vai trò</th>
                    <th class="text-center">Số bài viết đã tạo</th>
                    <th class="text-end" style="width: 250px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var a in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">@a.AccountID</td>
                            <td class="fw-bold text-dark">
                                <i class="bi bi-person-circle text-secondary me-2"></i>@a.AccountName
                            </td>
                            <td><code>@a.AccountEmail</code></td>
                            <td class="text-center">
                                @if (a.AccountRole == 1)
                                {
                                    <span class="badge badge-role-admin rounded-pill px-3 py-1">Admin</span>
                                }
                                else
                                {
                                    <span class="badge badge-role-staff rounded-pill px-3 py-1">Staff</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge @(a.CreatedArticleCount > 0 ? "bg-primary" : "bg-light text-muted border") rounded-pill px-3">
                                    @a.CreatedArticleCount bài viết
                                </span>
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-warning text-dark me-1" title="Đổi mật khẩu"
                                        onclick="openChangePasswordModal(@a.AccountID, '@Html.Raw(JavaScriptEscape(a.AccountName))')">
                                    <i class="bi bi-key"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary me-1" title="Sửa thông tin"
                                        onclick="openEditAccountModal(@a.AccountID, '@Html.Raw(JavaScriptEscape(a.AccountName))', '@Html.Raw(JavaScriptEscape(a.AccountEmail))', @a.AccountRole)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="Xóa tài khoản"
                                        onclick="confirmDeleteAccount(@a.AccountID, '@Html.Raw(JavaScriptEscape(a.AccountName))', @a.CreatedArticleCount)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="bi bi-people fs-1 d-block mb-2"></i>Không tìm thấy tài khoản nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Create Account -->
<div class="modal fade" id="createAccountModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-person-plus-fill me-2"></i>Tạo tài khoản mới</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" name="accountName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Địa chỉ Email <span class="text-danger">*</span></label>
                        <input type="email" name="accountEmail" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Vai trò <span class="text-danger">*</span></label>
                        <select name="accountRole" class="form-select" required>
                            <option value="2">Nhân viên biên tập (Staff)</option>
                            <option value="1">Quản trị viên (Admin)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mật khẩu ban đầu <span class="text-danger">*</span></label>
                        <input type="password" name="accountPassword" class="form-control" minlength="6" required />
                        <small class="text-muted">Tối thiểu 6 ký tự.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Tạo tài khoản</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edit Account -->
<div class="modal fade" id="editAccountModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editAccountForm" method="post">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Cập nhật thông tin tài khoản</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" name="accountName" id="editAccName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Địa chỉ Email <span class="text-danger">*</span></label>
                        <input type="email" name="accountEmail" id="editAccEmail" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Vai trò <span class="text-danger">*</span></label>
                        <select name="accountRole" id="editAccRole" class="form-select" required>
                            <option value="2">Nhân viên biên tập (Staff)</option>
                            <option value="1">Quản trị viên (Admin)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Change Password (Section 4.8: Require old password for password changes) -->
<div class="modal fade" id="changePasswordModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="changePasswordForm" method="post">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title"><i class="bi bi-key-fill me-2"></i>Đổi mật khẩu: <span id="changePwUserName"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mật khẩu hiện tại (Cũ) <span class="text-danger">*</span></label>
                        <input type="password" name="oldPassword" class="form-control" placeholder="Nhập mật khẩu cũ..." required />
                        <small class="text-muted">Hệ thống bắt buộc xác thực mật khẩu cũ trước khi đổi.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mật khẩu mới <span class="text-danger">*</span></label>
                        <input type="password" name="newPassword" class="form-control" minlength="6" placeholder="Nhập mật khẩu mới..." required />
                        <small class="text-muted">Tối thiểu 6 ký tự.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-check-lg me-1"></i>Xác nhận đổi mật khẩu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<form id="deleteAccountForm" method="post" style="display:none;"></form>

@functions {
    public string JavaScriptEscape(string input) =>
        string.IsNullOrEmpty(input) ? "" : input.Replace("\\", "\\\\").Replace("'", "\\'").Replace("\"", "\\\"").Replace("\r", "").Replace("\n", "\\n");
}

@section Scripts {
<script>
    function openEditAccountModal(id, name, email, role) {
        document.getElementById('editAccountForm').action = '/Account/Edit/' + id;
        document.getElementById('editAccName').value = name;
        document.getElementById('editAccEmail').value = email;
        document.getElementById('editAccRole').value = role;
        new bootstrap.Modal(document.getElementById('editAccountModal')).show();
    }

    function openChangePasswordModal(id, name) {
        document.getElementById('changePasswordForm').action = '/Account/ChangePassword/' + id;
        document.getElementById('changePwUserName').innerText = name;
        new bootstrap.Modal(document.getElementById('changePasswordModal')).show();
    }

    function confirmDeleteAccount(id, name, articleCount) {
        if (articleCount > 0) {
            alert(`Không thể xóa tài khoản "${name}" vì tài khoản này đã tạo ${articleCount} bài viết trong hệ thống! Quy tắc nghiệp vụ cấm xóa tài khoản đã có bài viết.`);
            return;
        }

        confirmAction(`Bạn có chắc muốn xóa tài khoản "${name}"?`, function() {
            const form = document.getElementById('deleteAccountForm');
            form.action = '/Account/Delete/' + id;
            form.submit();
        });
    }
</script>
}
